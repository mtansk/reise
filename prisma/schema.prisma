generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================
// ========== Auth Models ==============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  chats           Chat[]
  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// =====================================
// ======= Business Logic Models =======

model Chat {
  chatId           String   @id @default(cuid())
  sourceLocationId String
  vibe             Vibe
  userId           String
  createdAt        DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceLocation  Location         @relation("SourceChats", fields: [sourceLocationId], references: [id])
  recommendations Recommendation[]

  @@index([userId])
}

enum Vibe {
  history
  partying
  nature
  family
  culture
  shopping
}

model Recommendation {
  recommendationId String  @id @default(cuid())
  locationId       String
  sourceLocationId String
  chatId           String?
  userId           String

  vibe                Vibe
  description         String   @db.Text
  vibeDescription     String   @db.Text
  citySizeDescription String   @db.Text
  timingDescription   String   @db.Text
  practicalTips       String   @db.Text
  score               Int
  isFavorite          Boolean  @default(false)
  createdAt           DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [chatId], onDelete: SetNull)

  destinationLocation Location @relation("DestinationLocation", fields: [locationId], references: [id])
  sourceLocation      Location @relation("SourceLocation", fields: [sourceLocationId], references: [id])

  @@index([userId, chatId])
}

model Photo {
  photoId    String   @id @default(cuid())
  locationId String
  url        String   @db.Text
  author     String   @default("")
  alt        String   @default("")
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

model Location {
  id   String @id
  name String

  photos Photo[]

  recommendationsAsDest   Recommendation[] @relation("DestinationLocation")
  recommendationsAsSource Recommendation[] @relation("SourceLocation")
  chatsAsSource           Chat[]           @relation("SourceChats")
}
